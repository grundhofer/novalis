{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "1.2.0",
  "productName": "novalis",
  "identifier": "io.github.grundhofer.novalis",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "novalis",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 25
        },
        "dragDropEnabled": false,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Markdown notes, a text editor and a small Kanban board",
    "copyright": "\u00a9 Sebastian Grundh\u00f6fer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Plain Text",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "text",
          "rst",
          "adoc",
          "org",
          "textile",
          "mkd",
          "mdx",
          "rmd",
          "qmd",
          "srt",
          "vtt",
          "tex",
          "ltx",
          "json",
          "json5",
          "jsonc",
          "yaml",
          "yml",
          "toml",
          "xml",
          "xsl",
          "xsd",
          "plist",
          "svg",
          "csv",
          "tsv",
          "log",
          "diff",
          "patch",
          "bib",
          "ini",
          "properties",
          "cfg",
          "env",
          "conf",
          "html",
          "htm",
          "css",
          "scss",
          "sass",
          "less",
          "js",
          "mjs",
          "cjs",
          "jsx",
          "ts",
          "mts",
          "cts",
          "tsx",
          "vue",
          "py",
          "rb",
          "pl",
          "pm",
          "php",
          "lua",
          "tcl",
          "ps1",
          "sh",
          "bash",
          "zsh",
          "c",
          "h",
          "cpp",
          "cc",
          "cxx",
          "hpp",
          "hh",
          "hxx",
          "rs",
          "go",
          "swift",
          "java",
          "kt",
          "kts",
          "scala",
          "cs",
          "groovy",
          "gradle",
          "dart",
          "hs",
          "ml",
          "mli",
          "elm",
          "erl",
          "clj",
          "cljs",
          "edn",
          "lisp",
          "el",
          "scm",
          "r",
          "jl",
          "sql",
          "proto",
          "dockerfile",
          "cmake",
          "mk"
        ],
        "name": "Text",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "pdf",
          "epub",
          "cbz",
          "docx",
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "heic",
          "heif",
          "avif"
        ],
        "name": "Document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
